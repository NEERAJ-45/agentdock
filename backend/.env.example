API_TOKEN=change-me-to-a-long-random-string
PORT=8080
# Only paths under these roots can be registered as workspaces (separate with ;)
ALLOWED_WORKSPACE_ROOTS=C:\Projects
OPENCODE_IMAGE=agentdock:latest
INSTANCE_MEMORY_MB=2048
INSTANCE_CPUS=2
QUOTA_COOLDOWN_MIN=60
# Automatic switching to another instance after a usage-limit error.
# Enable ONLY if each instance uses its own legitimately-held account/key and the provider's terms allow it.
AUTO_SWITCH=false
# Pool of credential profiles for containers spawned on quota exhaustion (folders under this dir, one container each)
PROFILES_DIR=../data/profiles
MAX_INSTANCES=6
